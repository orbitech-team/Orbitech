<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     Web.config — ASP.NET Configuration File
     ============================================================
     TUTORIAL STEP: This is the master configuration file for the project.
     It contains:
       1. The database connection string (tells the app where SQL Server is)
       2. WCF service configuration (tells the app how to serve the .svc files)
       3. Authentication settings (how login/session works)

     CRITICAL: You MUST update the connection string below to match
     your SQL Server instance. See the tutorial for details.

     PLACE THIS FILE IN: OrbitechWeb/Web.config (root of the project)
     ============================================================ -->
<configuration>

  <!-- ============================================================
       1. DATABASE CONNECTION STRING
       ============================================================
       TUTORIAL STEP: Change "YOUR_SERVER_NAME" to your SQL Server instance name.
       
       Common values:
       - ".\SQLEXPRESS"  → if using SQL Server Express (default for VS installs)
       - "localhost"     → if using a local SQL Server Developer/Standard edition
       - "(localdb)\MSSQLLocalDB" → if using LocalDB (lightweight, comes with VS)
       
       If your SQL Server has a password, change "Integrated Security=True" to:
       "User ID=yourUsername;Password=yourPassword;"
       ============================================================ -->
  <connectionStrings>
    <add name="OrbitechDB"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=ORBITECH_DATA;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

	<system.web>
    <!-- TUTORIAL STEP:compilation debug="true" enables debugging. 
         Set to false before deploying to production. -->
    <compilation debug="true" targetFramework="4.7.2">
      <assemblies>
        <add assembly="System.ServiceModel, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"/>
      </assemblies>
    </compilation>

    <!-- TUTORIAL STEP: Authentication mode="Forms" enables cookie-based login.
         When a user logs in successfully, ASP.NET issues an authentication cookie.
         Pages in the "admin" folder can require this cookie. -->
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" defaultUrl="~/Default.aspx" timeout="30" />
    </authentication>

    <!-- TUTORIAL STEP: Allows the WCF service to be hosted within the ASP.NET app -->
    <httpRuntime targetFramework="4.7.2" />
    <pages>
      <controls>
        <add tagPrefix="asp" namespace="System.Web.UI.WebControls" assembly="System.Web"/>
      </controls>
    </pages>
  </system.web>

  <!-- ============================================================
       2. WCF SERVICE CONFIGURATION
       ============================================================ 
       TUTORIAL STEP: This section tells IIS how to serve the WCF .svc file.
       basicHttpBinding is the simplest binding — it uses HTTP and is
       compatible with older clients. It's perfect for a student project.
       ============================================================ -->
  <system.serviceModel>

    <!-- Behaviors define how the service handles metadata (WSDL).
         serviceMetadata httpGetEnabled="true" lets you browse to the .svc?wsdl
         URL to see the service description. -->
    <behaviors>
      <serviceBehaviors>
        <behavior name="OrbitechServiceBehavior">
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="true" />
        </behavior>
      </serviceBehaviors>
    </behaviors>

    <!-- Services section registers the WCF service -->
    <services>
      <service name="OrbitechWeb.Services.OrbitechService" behaviorConfiguration="OrbitechServiceBehavior">
        <endpoint address="" binding="basicHttpBinding" 
                   contract="OrbitechWeb.Services.IOrbitechService" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>

    <!-- ServiceHostingEnvironment enables the .svc file to work in ASP.NET -->
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
  </system.serviceModel>

  <!-- ============================================================
       3. SYSTEM.WEB.SERVER (IIS 7+ settings)
       ============================================================ -->
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" 
           path="*." 
           verb="*" 
           type="System.Web.Handlers.TransferRequestHandler" 
           preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>

</configuration>
